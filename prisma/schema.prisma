datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model WhistleblowerReport {
  id          String       @id @default(cuid())
  city        String
  institution String?
  content     String
  latitude    Float?
  longitude   Float?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([city])
}
