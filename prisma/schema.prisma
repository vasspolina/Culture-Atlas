datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// One whistleblower review of one place. `institution` is the place's name as the atlas gives it; `placeId` is its id.
// latitude, longitude and rating are never written; they stay only so an existing database needs no destructive change.
// (A rating column was added and then dropped from the form; rows keep it empty.)
model WhistleblowerReport {
  id          String       @id @default(cuid())
  placeId     String?
  city        String
  institution String?
  content     String
  rating      Int?
  authorLabel String?
  latitude    Float?
  longitude   Float?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  files       ReportFile[]

  @@index([status])
  @@index([city])
  @@index([placeId, status])
}

// A photo, screenshot or PDF sent with a review (server/files.js). Shown publicly only while its review is APPROVED.
// No file name is stored. Deleting the review deletes its files.
model ReportFile {
  id        String              @id @default(cuid())
  reportId  String
  report    WhistleblowerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  position  Int
  type      String
  size      Int
  data      Bytes
  createdAt DateTime            @default(now())

  @@index([reportId])
}
