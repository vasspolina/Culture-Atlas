<script>
// Watch for native hover class changes on menu items
(function() {
    // Select the header container
    const headerContainer = document.querySelector('.main-header-container');
    
    // Select all top-level menu items
    const menuItems = document.querySelectorAll('.jet-mega-menu-list .jet-mega-menu-item--top-level');
    
    // Select button elements
    const btnGhostWhite = document.querySelectorAll('.btn-ghost-white');
    const btnSolidWhite = document.querySelectorAll('.btn-solid-white');
    const targetElements = [headerContainer, ...btnGhostWhite, ...btnSolidWhite];
    
    // Exit if elements don't exist
    if (!headerContainer || menuItems.length === 0) {
        console.warn('Header container or menu items not found');
        return;
    }
    
    // Store timeout reference
    let removeTimeout = null;
    
    // Function to check if any menu item has the hover class
    const checkForActiveHover = () => {
        const hasHover = Array.from(menuItems).some(item => 
            item.classList.contains('jet-mega-menu-item--hover')
        );
        
        if (hasHover) {
            // Clear any pending removal timeout
            if (removeTimeout) {
                clearTimeout(removeTimeout);
                removeTimeout = null;
            }
            // Add class immediately to all targets
            targetElements.forEach(el => el && el.classList.add('mega-menu-active'));
        } else {
            // Delay removal by 100ms
            removeTimeout = setTimeout(() => {
                targetElements.forEach(el => el && el.classList.remove('mega-menu-active'));
                removeTimeout = null;
            }, 100);
        }
    };
    
    // Create a MutationObserver to watch for class changes
    const observer = new MutationObserver(checkForActiveHover);
    
    // Observe each menu item for class attribute changes
    menuItems.forEach(menuItem => {
        observer.observe(menuItem, {
            attributes: true,
            attributeFilter: ['class']
        });
    });
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  function processCard(card) {
    if (card.dataset.newChipChecked) return;
    const now = new Date();
    const currentMonth = now.getMonth() + 1;
    const currentYear = now.getFullYear();

    const dateEl = card.querySelector('.post-date-chip');
    const chip = card.querySelector('.new-chip');
    if (!dateEl || !chip) return;

    const [day, month, year] = dateEl.textContent.trim().split('/').map(Number);
    const isCurrentMonth = month === currentMonth && year === currentYear;
    chip.style.display = isCurrentMonth ? '' : 'none';
    card.dataset.newChipChecked = '1';
  }

  // Process whatever is already rendered
  document.querySelectorAll('.artwork-listing-card').forEach(processCard);

  // Find the ONE grid that actually holds these cards (there are ~37
  // .jet-listing-grid__items on this page for other widgets/previews —
  // picking by class name alone grabs the wrong, unrelated one)
  const firstCard = document.querySelector('.artwork-listing-card');
  const grid = firstCard ? firstCard.closest('.jet-listing-grid__items') : document.body;

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((m) => {
      m.addedNodes.forEach((node) => {
        if (node.nodeType !== 1) return;
        if (node.matches?.('.artwork-listing-card')) processCard(node);
        node.querySelectorAll?.('.artwork-listing-card').forEach(processCard);
      });
    });
  });
  observer.observe(grid, { childList: true, subtree: true });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const STAGGER_DELAY = 120;
  const allElements = document.querySelectorAll('.animation-move-up');

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((e) => e.isIntersecting);

    visible.forEach((entry, batchIndex) => {
      setTimeout(() => {
        entry.target.classList.add('active');
      }, batchIndex * STAGGER_DELAY);
      observer.unobserve(entry.target);
    });
  }, {
    threshold: 0.15,
    rootMargin: '0px 0px -40px 0px'
  });

  allElements.forEach((el) => observer.observe(el));
});
</script>

    
