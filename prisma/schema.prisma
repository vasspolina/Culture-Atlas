datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// One whistleblower review of one place. `institution` is the place's name as the atlas gives it; `placeId` is its id.
// latitude, longitude and rating are never written; they stay only so an existing database needs no destructive change.
// (A rating column was added and then dropped from the form; rows keep it empty.)
model WhistleblowerReport {
  id          String       @id @default(cuid())
  placeId     String?
  city        String
  institution String?
  content     String
  rating      Int?
  authorLabel String?
  latitude    Float?
  longitude   Float?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([city])
  @@index([placeId, status])
}

// One reader's suggested change to what a record says. `field` is which part of the record it is about (funding or
// publishes), `original` the text as the reader saw it, `proposed` their version, `source` where they learned it.
// A suggestion changes nothing on the atlas by itself: the editor reads it and edits the record.
model EditSuggestion {
  id          String       @id @default(cuid())
  placeId     String
  institution String?
  field       String
  original    String
  proposed    String
  source      String?
  authorLabel String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([placeId, status])
}
